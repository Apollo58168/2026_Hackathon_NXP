__pycache__/
*.py[cod]

# Model weights and compiled inference artifacts. Keep documentation and
# small label/prior text files available, but never commit binary checkpoints.
*.pt
*.pth
*.tflite
*.onnx
*.eiq
*.eiq.json
*.elf
*.engine
*.ckpt
*.safetensors
*.h5
*.pb

# Local Hugging Face download bookkeeping (model files stay in models/).
models/**/.cache/

# Generated model bundles/calibration archives.
deploy/**/model/
deploy/**/calibration/*.zip
